    {
      "name": "mlmodel-1",
      "api": "rdk:service:mlmodel",
      "model": "viam:mlmodel-tflite:tflite_cpu",
      "attributes": {
        "package_reference": "6d6c7293-bc67-43e4-9c8b-31c76aac27d3/cup-detection",
        "model_path": "${packages.ml_model.cup-detection}/cup-detection.tflite",
        "label_path": "${packages.ml_model.cup-detection}/labels.txt"
      }
    },
    {
      "name": "vision-1",
      "api": "rdk:service:vision",
      "model": "rdk:builtin:mlmodel",
      "attributes": {
        "default_minimum_confidence": 0.5,
        "mlmodel_name": "mlmodel-1"
      }
    },
    {
      "name": "segmentation",
      "api": "rdk:service:vision",
      "model": "viam:vision:detections-to-segments",
      "attributes": {
        "detector_name": "vision-1",
        "camera_name": "cam",
        "mean_k": 5,
        "sigma": 1.25,
        "confidence_threshold_pct": 0.5,
        "depth_threshold_mm": 100,
        "min_points_in_segment": 50,
        "clustering_radius_mm": 10
      }
    }
