          "arm": {
            "5": {
              "min": -3.1416,
              "max": 3.1416
            }
          }
        }
      }
    },
    {
      "name": "calibration-handeye",
      "api": "rdk:service:generic",
      "model": "viam:camera-calibration:handeye",
      "attributes": {
        "arm": "arm",
        "pose_tracker": "calibration-charuco",
        "auto_apply_result": false,
        "input_range_override": {
          "0": {
            "Min": -1.5708,
            "Max": 1.5708
          },
          "1": {
            "Min": -1.5708,
            "Max": 0.5236
          },
